--langdef=ObjdumpD
--map-ObjdumpD=+.objdump

--kinddef-ObjdumpD=S,section,sections
--kinddef-ObjdumpD=s,symbol,symbols
--_roledef-ObjdumpD.{symbol}=called,specified as a callable

--regex-ObjdumpD=/^Disassembly of section ([^:]+)/\1/S/p{exclusive}{{
   _scopeclear
   .  _scopepush
}}

--regex-ObjdumpD=/^[0-9a-f]+ <([^>]+)>:/\1/s/p{exclusive}{{
   _scopedepth 2 eq {
      _scopepop
   } if
   . _scoperef
   . _scopepush
}}

--regex-ObjdumpD=/^[ \t]+[0-9a-f]+:[ \t]+(?:(?:[0-9a-f][0-9a-f] )+|[0-9a-f]+)[ \t]+(?:call.+|bl)[^<]*<([^>+]+)(\+0x[a-f0-9]+)?>.*/\1/s/p{_role=called}{{
   _scopetop {
      . _scoperef
      :name . :name eq {
         . _markplaceholder
      } if
   } if
}}
